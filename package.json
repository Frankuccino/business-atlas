{
  "name": "business-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "build:priority": "tsx scripts/build-priority.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w packages/api",
    "dev:web": "npm run dev -w packages/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
